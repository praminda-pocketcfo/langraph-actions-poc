# Classic PAT (repo + workflow) or a fine-grained token that can:
# - contents: write and pull requests: write on the submission repo
# - actions: write on the evaluation repo
# New-repo mode needs permission to create private repositories (classic `repo`
# scope, or a GitHub App). A fine-grained token will not see repos created later.
GITHUB_TOKEN=

# Branch mode. Must already exist, be private, and have one commit on the base branch.
GITHUB_SUBMISSION_REPO=owner/learner-submissions
# Optional. Defaults to the repo's default branch.
GITHUB_SUBMISSION_BASE=main

# Where project-evaluation.yml lives.
GITHUB_EVAL_REPO=owner/langraph-actions-poc
GITHUB_EVAL_WORKFLOW=project-evaluation.yml
GITHUB_EVAL_REF=main

# New-repo mode only. Leave empty to create the repo on the token's user.
# Set this to create it inside an organization instead.
GITHUB_ORG=
