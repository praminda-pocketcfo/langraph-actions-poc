# Actions: write on the evaluation repo. The portal only dispatches the workflow.
GITHUB_TOKEN=

# Where project-evaluation.yml lives.
GITHUB_EVAL_REPO=owner/langraph-actions-poc
GITHUB_EVAL_WORKFLOW=project-evaluation.yml
GITHUB_EVAL_REF=main

# Folder in a real user's Drive, shared with the service account as Editor.
# Service accounts have no storage quota of their own. A Shared Drive works too.
GDRIVE_ROOT_FOLDER_ID=

# Service account key. Use base64 of the JSON file so .env stays one line:
#   base64 < service-account.json | tr -d '\n'
# Same JSON, raw, as the Actions secret GOOGLE_SERVICE_ACCOUNT_JSON on the
# evaluation repo. The workflow downloads the zip with the Python Drive client.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Or the raw JSON on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON=
